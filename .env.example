# ==========================================
# DineDash Backend - Environment Variables
# ==========================================

# ------------------------------------------
# Server Configuration
# ------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------
# Database Configuration (PostgreSQL / Aiven)
# ------------------------------------------
# Option 1: Full Connection String (Recommended for Cloud / Aiven DB)
DATABASE_URL=postgres://user:password@host.aivencloud.com:20291/defaultdb?sslmode=require

# Option 2: Separate DB Parameters (Used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=dinedash
DB_SSL=false

# ------------------------------------------
# Authentication & Licensing Security
# ------------------------------------------
JWT_SECRET=your_jwt_secret_key_change_in_production
LICENSE_SECRET_KEY=dinedash-pos-licensing-cryptographic-secret-key-2026

# ------------------------------------------
# Email / SMTP Settings (Nodemailer)
# ------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM=your_email@gmail.com
FROM_NAME="DineDash POS"
EMAIL_USER=no-reply@dinedash.com

# ------------------------------------------
# Frontend Integration
# ------------------------------------------
FRONTEND_URL=http://localhost:3000
